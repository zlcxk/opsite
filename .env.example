# 服务端口
PORT=8787

# 监听地址，默认仅本机；需要局域网访问时改为 0.0.0.0
HOST=127.0.0.1

# 可选：GitHub token，提高 API 速率限制
GITHUB_TOKEN=

# 可选：NVD API key，提高请求速率限制
NVD_API_KEY=

# 可选：关闭内置定时采集（true / false）；设为 true 会同时停止软件同步与技术发现
DISABLE_SCHEDULER=false

# 软件同步周期（cron 表达式，默认每 6 小时）
SYNC_CRON=0 */6 * * *

# 技术发现：是否启用每日自动采集（默认启用；false 仅关闭技术发现，不影响软件同步）
DISCOVERY_ENABLED=true

# 技术发现：采集周期与时区（默认每天 09:00，Asia/Shanghai）
DISCOVERY_CRON=0 9 * * *
DISCOVERY_TIMEZONE=Asia/Shanghai

# 通知与邮件
# 用于加密 SMTP 密码。留空时会在 data/.secret 自动生成；迁移数据目录时请一并保留，
# 否则已保存的 SMTP 密码无法解密。
OPSITE_SECRET=

# 邮件中的站内链接前缀（默认 http://127.0.0.1:PORT）。部署到其他地址时需要设置。
PUBLIC_BASE_URL=

# 通知时区，用于免打扰时段与每日摘要时间（默认 Asia/Shanghai）
NOTIFICATION_TIMEZONE=Asia/Shanghai

# 可选：停止后台邮件发送队列（true / false）。站内通知不受影响，待发送邮件会保留。
DISABLE_EMAIL_QUEUE=false
